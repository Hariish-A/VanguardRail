        {
          "id": "most-restrictive-wins",
          "description": "A confidential path that is also a credential store matches a log_and_allow rule and a block rule at once. The strictest wins, and both are recorded -- which is what makes the outcome independent of rule order in the file.",
          "critical": true,
          "tags": [],
          "action": {
            "tool": "file.read",
            "arguments": {
              "path": "/srv/confidential/.env"
            },
            "context": {}
          },
          "expect": {
            "decision": "block",
            "allowed": false,
            "rules": [
              "confidential-read-audit",
              "credentials-path-block"
            ],
            "rules_absent": [],
            "message_contains": null,
            "unknown_paths": []
          }
        },
        {
          "id": "production-context-escalates",
          "description": "A five-row delete is unremarkable in staging and needs a human in production. The same action, a different context, a different answer.",
          "critical": false,
          "tags": [],
          "action": {
            "tool": "db.delete_records",
            "arguments": {
              "table": "orders",
              "count": 5
            },
            "context": {
              "environment": "production"
            }
          },
          "expect": {
            "decision": "require_hitl",
            "allowed": false,
            "rules": [
              "destructive-tool-in-production"
            ],
            "rules_absent": [
              "db-bulk-delete"
            ],
            "message_contains": null,
            "unknown_paths": []
