        {
          "id": "unmatched-tool-allowed",
          "description": "A tool no rule mentions falls through to the bundle default. Worth asserting: it is what distinguishes \"default-permit, layered over working agents\" from a policy that silently governs nothing.",
          "critical": false,
          "tags": [],
          "action": {
            "tool": "http.request",
            "arguments": {
              "method": "GET",
              "url": "https://status.acme-corp.com/health"
