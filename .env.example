# Guardrail — local configuration template
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
#
#     cp .env.example .env
#
# Nothing here is required to run the tests or the local server; every value has a
# working default. The AWS entries only matter when you deploy.
#
# In deployed stages these values do NOT come from this file — CDK sets them as Lambda
# environment variables, and anything secret lives in SSM Parameter Store (which is
# free; Secrets Manager is $0.40/secret/month and is deliberately not used).

# ---------------------------------------------------------------------------
# Service identity
# ---------------------------------------------------------------------------

# local | dev | prod. Controls log verbosity and whether tracing is enabled.
GUARDRAIL_STAGE=local

# Build identifier. CI sets this to the git SHA so a running deployment is traceable
# back to a commit. Leave as-is locally.
GUARDRAIL_VERSION=local-dev

# DEBUG | INFO | WARNING | ERROR
GUARDRAIL_LOG_LEVEL=DEBUG

# ---------------------------------------------------------------------------
# AWS  (only needed for deployment — see "What you need to provide" in PROGRESS.md)
# ---------------------------------------------------------------------------

# CloudFront-associated resources must be created in us-east-1. Changing this will
# break the distribution.
GUARDRAIL_AWS_REGION=us-east-1

# Where the zero-spend budget alarm sends mail. If this is empty, the budget stack is
# skipped entirely — an alarm nobody receives is worse than no alarm, because it
# creates false confidence.
GUARDRAIL_ALERT_EMAIL=

# Set automatically by the AWS CLI/CDK from your configured credentials. Only set these
# by hand if you are targeting an account other than your default profile's.
# CDK_DEFAULT_ACCOUNT=
# CDK_DEFAULT_REGION=us-east-1

# Set to 1 to let `cdk synth` run without Docker. Synth/validation only — the asset it
# produces is a placeholder and must never be deployed.
# GUARDRAIL_SKIP_BUNDLING=1

# ---------------------------------------------------------------------------
# Storage — created in M1. Left blank here; `/readyz` reports them as unprovisioned.
# ---------------------------------------------------------------------------

GUARDRAIL_AUDIT_TABLE_NAME=
GUARDRAIL_DECISIONS_TABLE_NAME=
GUARDRAIL_POLICIES_TABLE_NAME=

# ---------------------------------------------------------------------------
# LLM  (live as of M2 -- the demo agent reads these)
# ---------------------------------------------------------------------------
#
# Defaults target free local inference, so nothing here is required. The guardrail's own
# decision path never calls a model, so none of this affects enforcement -- only the
# agent's ability to choose a tool.

# Ollama's OpenAI-compatible endpoint. From inside a container on Windows, reach the host
# with http://host.docker.internal:11434/v1 instead of localhost.
GUARDRAIL_LLM_BASE_URL=http://localhost:11434/v1
GUARDRAIL_LLM_MODEL=qwen3:latest

# Ollama ignores the value, but the OpenAI wire format requires the header to be present.
GUARDRAIL_LLM_API_KEY=ollama

# Qwen3 reasons before answering unless told not to. Measured on this project: thinking
# blew past a 300s timeout on a five-tool prompt, while /no_think returned a correct tool
# call in 34s. Set to 1 to re-enable reasoning.
# GUARDRAIL_LLM_THINKING=0

# Any OpenAI-compatible provider works by changing the three variables above -- proven by
# tests/unit/test_llm_providers.py, which parses recorded Ollama, Groq, and OpenAI
# responses and asserts they yield identical results. For example:
#   GUARDRAIL_LLM_BASE_URL=https://api.groq.com/openai/v1
#   GUARDRAIL_LLM_MODEL=qwen/qwen3-32b
#   GUARDRAIL_LLM_API_KEY=gsk_...
#
# Bedrock is deliberately NOT supported: it bills per token and is on the cost gate's
# banned list, so it cannot be used under this project's $0 constraint.

# ---------------------------------------------------------------------------
# AWS-hosted agent  (M5) -- optional, and only needed to deploy Guardrail-Agent-<stage>
# ---------------------------------------------------------------------------
#
# The demo agent also runs as its own Lambda, so the brief's "govern agents ALSO hosted
# on AWS" is satisfied literally rather than by analogy. It needs hosted inference,
# because a Lambda cannot reach Ollama on your laptop.
#
# Groq's free plan is used rather than a cloudflared tunnel back to a local Ollama: the
# tunnel works, but the demo then only runs while one particular machine is awake, and it
# publishes an unauthenticated Ollama to the internet.
#
# Get a key at https://console.groq.com (free plan, rate-limited per minute/day).
GROQ_API_KEY=

# Which control plane the agent is governed by. Setting this is what causes the agent
# stack to be synthesized at all -- an agent with nothing governing it demonstrates
# nothing, so the stack is skipped rather than deployed half-configured.
GUARDRAIL_AGENT_TARGET_URL=

# The guardrail API key the agent presents. Reuse an evaluate-scoped key; do NOT give the
# agent the policy-admin key, or it could rewrite the policy that governs it.
GUARDRAIL_AGENT_GUARDRAIL_KEY=

# The agent's OWN endpoint key. Only the SHA-256 digest is deployed, so the function's
# configuration discloses no usable credential. Required: the handler refuses every
# request when no digest is configured, because each invocation spends Groq quota and an
# open endpoint is a denial-of-wallet.
GUARDRAIL_AGENT_API_KEY=
GUARDRAIL_AGENT_KEY_SHA256=

# Override the model if Groq retires this one. Any OpenAI-compatible model with tool
# calling works.
# GUARDRAIL_LLM_MODEL=qwen/qwen3.6-27b

# ---------------------------------------------------------------------------
# Agent -> guardrail  (used by the SDK and the demo agent)
# ---------------------------------------------------------------------------

# The deployed control plane the SDK calls before every tool execution.
GUARDRAIL_BASE_URL=

# Mint one with: uv run python scripts/generate_api_key.py --tenant acme
#
# Keys carry a ROLE, set in the deployed GUARDRAIL_API_KEYS_JSON table:
#
#   agent    (default) evaluate, simulate, read. Cannot approve, cannot change policy.
#   reviewer the above, plus resolving actions held for human review.
#   admin    the above, plus publishing and activating policy.
#
# The default is `agent` deliberately: a key table entry that forgets to state a role must
# get the LEAST privilege. Before roles existed any valid key could resolve, which meant an
# agent could approve the very action its own policy had held for a human.
# Only the hash is ever stored server-side.
GUARDRAIL_API_KEY=

# ---------------------------------------------------------------------------
# Review console (M6)
# ---------------------------------------------------------------------------
# Browser origins permitted to call the control plane and the agent Function URLs.
# Matched verbatim against the Origin header -- scheme included. Deliberately not "*":
# these requests carry credentials, and a wildcard origin with credentials is both
# rejected by browsers and wrong in principle.
#
# After deploying Guardrail-Console-<stage>, its ConsoleAllowedOrigin output is the exact
# string to put here.
GUARDRAIL_CONSOLE_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to 1 to deploy the React console to S3. Opt-in, because the stack requires
# apps/console-ui/dist to exist -- deploying without a build would publish an empty
# bucket, and a console returning 404 reads as a service outage.
GUARDRAIL_DEPLOY_CONSOLE=0
